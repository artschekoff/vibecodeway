  "silent": false,
  "global": false,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "ca_rules": {
    "base": "d2b4a21cb135fce78976780bad40370ce95a10d3",
    "projects/juna": "f1146696197ef1ef732f5f7ef7c417ed5410524b",
    "stacks/tauri-react-rust": "3cd425e3789ffe3561fa11a3f6621a8c52337a5b"
  }
